---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { aff } from "../../data/affiliates";
import { asset, path } from "../../lib/paths";
const pageImage = asset("images/page-sea.jpg");

const faq = [
  {
    q: "В каком районе Батуми лучше остановиться?",
    a: "На короткий пляжный отдых — в Старом городе или в квартале-двух от Бульвара: пешком до моря, ресторанов и площади Европы. Надолго и с кухней — в новых высотках на юге города.",
  },
  {
    q: "Когда пляжный сезон в Батуми?",
    a: "С июня по сентябрь. Июль и август — самые людные и дорогие месяцы, бронируйте заранее. В мае и октябре тише и дешевле, но море прохладнее и чаще идут дожди.",
  },
  {
    q: "В Батуми песчаный пляж?",
    a: "Нет, городской пляж галечный. Если на гальке неудобно, возьмите коралловые тапочки.",
  },
  {
    q: "Как добраться из Тбилиси в Батуми?",
    a: "Удобнее всего на поезде, около 5 часов. Ещё можно прилететь прямо в аэропорт Батуми или поехать на автобусе или маршрутке.",
  },
  {
    q: "Батуми дешевле Тбилиси?",
    a: "Вне сезона жильё в Батуми часто дешевле. В июле и августе цены у моря заметно выше, особенно на номера с видом на море.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---

<BaseLayout
  title="Где остановиться в Батуми (2026): у моря, в Старом городе или в новых высотках | ArriveGE"
  description="Какой район Батуми выбрать: Старый город для прогулок, Бульвар для вида на море, новые высотки для апартаментов. Шум, пляж, сезон и советы по бронированию."
  nextHref="/ru/esim-georgia"
  nextLabel="eSIM для Грузии"
>
  <script type="application/ld+json" set:html={faqSchema} />

  <header class="page-hero has-photo" style={`--page-image: url('${pageImage}')`}>
    <div class="page-hero-inner" data-reveal>
      <p class="section-kicker">Чёрное море</p>
      <h1>Где остановиться в Батуми</h1>
      <p>
        Коротко на море: Старый город или квартал от Бульвара. Надолго и с кухней: апартаменты в новых высотках. Вид на
        море стоит дороже, и летом такие номера раскупают первыми.
      </p>
    </div>
  </header>

  <main class="section content-grid">
    <article class="prose" data-reveal>
      <h2>Районы в одной таблице</h2>
      <table class="compare">
        <thead>
          <tr>
            <th>Район</th>
            <th>Кому подойдёт</th>
            <th>До пляжа</th>
            <th>Шум</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Старый город</td>
            <td>Первый визит, прогулки, еда</td>
            <td>5–10 мин пешком</td>
            <td>Средне</td>
          </tr>
          <tr>
            <td>Бульвар у моря</td>
            <td>Вид на море, короткий отдых</td>
            <td>Через дорогу</td>
            <td>Летом шумно</td>
          </tr>
          <tr>
            <td>Новые высотки (юг)</td>
            <td>Апартаменты, долгий отдых, семьи</td>
            <td>Пешком или коротко на Bolt</td>
            <td>Тихо, но рядом стройки</td>
          </tr>
          <tr>
            <td>Окраины / Махинджаури / Гонио</td>
            <td>Спокойный пляжный отдых</td>
            <td>Часто первая линия</td>
            <td>Тихо</td>
          </tr>
        </tbody>
      </table>

      <h2>Старый город</h2>
      <p>
        Отреставрированные улицы XIX века вокруг площади Европы и Пьяццы, много кафе и ресторанов. До Бульвара и пляжа
        пешком. Лучшая база для первого визита на 2–4 ночи.
      </p>

      <h2>Бульвар у моря</h2>
      <p>
        Длинная набережная с велодорожками и парками. Смысл в том, чтобы просыпаться с видом на море. Минусы: летом по
        ночам людно и шумно, а номера «с видом на море» дороже. Отель в квартале от набережной часто тише за те же деньги.
      </p>

      <h2>Новые высотки на юге</h2>
      <p>
        Батумские небоскрёбы — это в основном апартаменты с кухней и балконом. Выгодно для долгого отдыха и семей.
        Посмотрите на карту: от некоторых башен далеко до Старого города, а вокруг многих ещё идёт стройка.
      </p>

      <h2>Окраины: Махинджаури и Гонио</h2>
      <p>
        К северу и к югу от города, ближе к Ботаническому саду или крепости Гонио. Пляжи спокойнее, но в город придётся
        ездить на Bolt или автобусе.
      </p>

      <h2>Советы по бронированию</h2>
      <ul>
        <li><strong>Июль–август:</strong> бронируйте заранее, номера с видом на море уходят первыми.</li>
        <li><strong>Май, июнь, сентябрь:</strong> хорошая погода и цены ниже; выбор большой, есть что сравнить.</li>
        <li><strong>Проверьте стройки</strong> в свежих отзывах, особенно в районе новых высоток.</li>
        <li><strong>Выбирайте бесплатную отмену,</strong> пока даты могут сдвинуться.</li>
        <li><strong>Нет иностранной карты?</strong> Ищите оплату на месте и берите наличные.</li>
        <li>
          <strong>Едете из Тбилиси?</strong> Смотрите <a href={path("ru/tbilisi-hotels")}>где жить в Тбилиси</a> на первую
          часть поездки.
        </li>
      </ul>

      <h2>Частые вопросы</h2>
      {
        faq.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }
    </article>

    <aside class="action-panel" data-reveal>
      <h2>Жильё в Батуми</h2>
      <p>Выберите район, укажите даты и сравните вид на море и квартал от набережной.</p>
      <a class="btn btn-primary" href={aff("hotelsBatumi")} target="_blank" rel="noopener sponsored noreferrer"
        >Отели в Батуми</a
      >
      <a class="btn btn-ghost" href={path("ru/tbilisi-hotels")}>Нужен Тбилиси?</a>
      <p class="disclaimer">Партнёрская ссылка: мы можем получить комиссию с бронирований через неё.</p>
    </aside>
  </main>
</BaseLayout>
