---
import BaseLayout from "../layouts/BaseLayout.astro";
import { asset, path } from "../lib/paths";
const heroImage = asset("images/hero.jpg");


const needs = [
  {
    num: "01",
    href: path("flights-to-georgia"),
    title: "Flights to Georgia",
    text: "Compare tickets to Tbilisi, Batumi, or Kutaisi.",
  },
  {
    num: "02",
    href: path("esim-georgia"),
    title: "Internet from the gate",
    text: "Install eSIM at home. City plans vs mountain coverage.",
  },
  {
    num: "03",
    href: path("tbilisi-airport-transfer"),
    title: "Ride from Tbilisi Airport",
    text: "Bolt on arrival vs a driver waiting with your name.",
  },
  {
    num: "04",
    href: path("tbilisi-hotels"),
    title: "Where to sleep in Tbilisi",
    text: "Old Town, Vera, or Vake — by walkability and budget.",
  },
  {
    num: "05",
    href: path("batumi-hotels"),
    title: "Where to sleep in Batumi",
    text: "Seafront, center, or quieter blocks away from the boulevard.",
  },
  {
    num: "06",
    href: path("kazbegi-day-trip"),
    title: "Kazbegi in one day",
    text: "Book the seat before you land. Gergeti fills up fast in season.",
  },
  {
    num: "+",
    href: path("kakheti-wine-tour"),
    title: "Kakheti wine day",
    text: "Driver tour or your own car — pick before the weekend rush.",
  },
];
---

<BaseLayout
  title="ArriveGE — Get Georgia ready before you land"
  description="eSIM, airport transfer, hotels, and day trips for Georgia. Book what you need before the plane doors open."
  homeNote
>
  <header
    class="hero has-photo"
    style={`--hero-image: url('${heroImage}')`}
  >
    <div class="hero-inner">
      <h1 class="brand-hero" data-reveal>Arrive<span>GE</span></h1>
      <p class="hero-lead" data-reveal data-reveal-delay="100">
        Georgia starts at landing. Get data, a ride, a bed, and your first day trip sorted before the doors open.
      </p>
      <div class="cta-row" data-reveal data-reveal-delay="180">
        <a class="btn btn-primary" href={path("flights-to-georgia")}>Compare flights</a>
        <a class="btn btn-ghost" href={path("esim-georgia")}>Get eSIM</a>
      </div>
    </div>
  </header>

  <main>
    <section class="section" id="needs">
      <p class="section-kicker" data-reveal>Before you fly</p>
      <h2 data-reveal>Five things every traveler books</h2>
      <p class="section-lead" data-reveal>
        Same checklist for every passport. Pick the page that matches what you still need.
      </p>

      <div class="need-list">
        {
          needs.map((item) => (
            <a class="need-item" href={item.href} data-reveal>
              <span class="need-num">{item.num}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
              <span class="need-go">Open →</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
