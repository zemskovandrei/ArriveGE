---
import { path } from "../lib/paths";

const links = [
  { href: path("flights-to-georgia"), label: "Flights" },
  { href: path("esim-georgia"), label: "eSIM" },
  { href: path("tbilisi-airport-transfer"), label: "Transfer" },
  { href: path("tbilisi-hotels"), label: "Tbilisi" },
  { href: path("batumi-hotels"), label: "Batumi" },
  { href: path("kazbegi-day-trip"), label: "Kazbegi" },
  { href: path("kakheti-wine-tour"), label: "Kakheti" },
];
---

<nav class="site-nav" aria-label="Primary">
  <a class="brand" href={path()}>Arrive<span>GE</span></a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">Menu</button>
  <ul class="nav-links" id="nav-menu">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>
