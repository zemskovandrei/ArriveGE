---
interface Props {
  nextHref?: string;
  nextLabel?: string;
  homeNote?: boolean;
}

const { nextHref, nextLabel, homeNote = false } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    {
      homeNote ? (
        <div>
          <strong class="brand">Arrive<span>GE</span></strong>
          <p>
            Independent trip checklist for Georgia. Some links are affiliate links — if you book through them, we may
            earn a commission at no extra cost to you.
          </p>
        </div>
      ) : (
        <a class="brand" href="/">Arrive<span>GE</span></a>
      )
    }
    {
      nextHref && nextLabel ? (
        <p>
          Next: <a href={nextHref}>{nextLabel}</a>
        </p>
      ) : homeNote ? (
        <p>English · works for any traveler</p>
      ) : (
        <p>
          Back to <a href="/">checklist</a>
        </p>
      )
    }
  </div>
</footer>
